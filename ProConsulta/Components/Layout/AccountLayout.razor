@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="0" Class="mud-appbar-blur">
        <MudText Typo="Typo.h6">Minha Conta</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.ExitToApp" Color="Color.Inherit" OnClick="@LogOff" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private void LogOff() => Navigation.NavigateTo("/Account/Manage/logout", forceLoad: true);
}